{
  "name": "drei-electron-app",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent always-on-top anime overlay widget",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.drei.electron-app",
    "productName": "Drei Overlay",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "extraMetadata": { "main": "dist-electron/main.js" },
    "win": { "target": "nsis", "icon": "public/icon.ico" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
